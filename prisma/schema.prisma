generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model UrlShortener {
  original_url String
  hashed_url   String       @id
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  expiresAt    DateTime
  userId       String?
  user         User?        @relation(fields: [userId], references: [id])
  clickEvents  ClickEvent[]

  @@index([original_url], type: Hash)
}

model User {
  id              String         @id @default(uuid())
  email           String         @unique
  password_hashed String
  createdAt       DateTime       @default(now())
  urls            UrlShortener[]
}

model ClickEvent {
  id               String   @id @default(uuid())
  shortener_url_id String
  createdAt        DateTime @default(now())
  ip               String?
  userAgent        String?

  shortUrl UrlShortener @relation(fields: [shortener_url_id], references: [hashed_url], onDelete: Cascade)

  @@index([shortener_url_id, createdAt])
}
